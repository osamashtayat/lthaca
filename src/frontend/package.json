{
  "name": "ithaca-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-no-mocks.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint --deny-warnings && npm run lint:tokens",
    "lint:tokens": "node scripts/check-design-tokens.mjs",
    "api:types": "npx --yes --package=typescript@5.9.3 --package=openapi-typescript@7.13.0 -- openapi-typescript ../../contracts/openapi.json -o src/shared/api/schema.d.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/shrikhand": "^5.3.0",
    "@microsoft/signalr": "^9.0.19",
    "@tanstack/react-query": "^5.106.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "msw": "^3.0.5",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}