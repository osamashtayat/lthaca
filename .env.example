# Copy to .env (gitignored). Placeholder values only — never commit real secrets.

# PostgreSQL + pgvector (docker compose). Host port 5433 so it can run next to FlowOps (5432).
POSTGRES_DB=ithaca
POSTGRES_USER=ithaca
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5433

# API settings. ASP.NET Core does NOT read this file: for `dotnet run`, export these into your shell
# (`set -a; source .env; set +a`) or use dotnet user-secrets. Double underscore = config section separator.
# Quoted: the semicolons would otherwise end the line when the file is sourced.
ConnectionStrings__Ithaca="Host=localhost;Port=5433;Database=ithaca;Username=ithaca;Password=change-me-local-only"

# External providers. Only Fake exists in the skeleton; keys stay empty until a real client is built (docs/ai.md).
Ai__LlmProvider=Fake
Ai__EmbeddingProvider=Fake
Ai__ApiKey=
Tmdb__Client=Fake
Tmdb__ApiKey=

# Full stack in Docker (docker compose up --build)
# Development seeds sample films and exposes /openapi/v1.json; Production does neither.
ITHACA_ENVIRONMENT=Development
ITHACA_WEB_PORT=8080

# Frontend dev proxy target (src/frontend/vite.config.ts)
ITHACA_API_URL=http://localhost:5280
