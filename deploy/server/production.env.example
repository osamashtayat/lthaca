# Template for /opt/ithaca/.env on the production VPS (docs/deployment.md, step 3). Placeholders only: the real file
# lives on the server (owner deploy, mode 600) and never in the repo, CI variables or logs.
# docker-compose.prod.yml reads it; ASPNETCORE_ENVIRONMENT=Production, the ports and the certificate paths are fixed there.

# PostgreSQL (generate a long random password once: `openssl rand -hex 32`)
POSTGRES_DB=ithaca
POSTGRES_USER=ithaca
POSTGRES_PASSWORD=<long-random-password>

# Origin certificate folder (origin.pem + origin.key from Cloudflare) and the public HTTPS port
ITHACA_CERT_DIR=/etc/ithaca/certs
ITHACA_HTTPS_PORT=443
# Changing the port also needs ITHACA_HTTPS_PORT in the firewall unit's environment (cloudflare-firewall.sh reads its
# own environment, not this file); otherwise the new port is not limited to Cloudflare.

# Providers (docs/ai.md). Real ones in production; keys from each provider's dashboard.
Ai__LlmProvider=Anthropic
Ai__LlmModel=claude-opus-5-5
Ai__ApiKey=<anthropic-key>
Ai__EmbeddingProvider=Voyage
Ai__EmbeddingApiKey=<voyage-key>
Tmdb__Client=Http
Tmdb__ApiKey=<tmdb-key>
Wikidata__Client=Http

# Password reset email (L4): Resend, sending-only key
Email__Provider=Resend
Email__ApiKey=<resend-key>
Email__SiteUrl=https://ithacamovies.com

# Error tracking (ADR-0028): the ithaca-server DSN. The release is set per deploy (ithaca-server@<commit>).
Sentry__Dsn=<ithaca-server-dsn>

# Catalog sync: off until OPS-08 sets the production values
CatalogSync__Enabled=false
